# MindMark local development variables.
# Spring Boot does not load this file automatically. Import it into your shell/IDE.

MINDMARK_SERVER_PORT=8080
MINDMARK_DB_HOST=localhost
MINDMARK_DB_PORT=5432
MINDMARK_DB_NAME=mindmark
MINDMARK_DB_USERNAME=postgres
MINDMARK_DB_PASSWORD=123456
MINDMARK_REDIS_HOST=localhost
MINDMARK_REDIS_PORT=6379
MINDMARK_REDIS_PASSWORD=
MINDMARK_MINIO_ENDPOINT=http://localhost:9000
MINDMARK_MINIO_ACCESS_KEY=minioadmin
MINDMARK_MINIO_SECRET_KEY=minioadmin123
MINDMARK_MINIO_BUCKET=mindmark-artifacts
MINDMARK_OPENAPI_ENABLED=false
MINDMARK_SECURITY_STRICT_SECRETS=false

# Use these values with apps/mindmark-server/docker-compose.yml instead:
# MINDMARK_DB_PORT=54321
# MINDMARK_DB_USERNAME=mindmark
# MINDMARK_DB_PASSWORD=mindmark_dev_password
# MINDMARK_REDIS_PASSWORD=change-me
